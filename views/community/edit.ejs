<%- include('../layout/header') %>

<div style="min-height: 100vh; padding: 2rem 0; background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);">
  <div style="max-width: 900px; margin: 0 auto; padding: 0 2rem;">

    <!-- 페이지 헤더 -->
    <div style="text-align: center; margin-bottom: 2rem;">
      <h1 style="font-size: 2.5rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.5rem;">
        ✏️ 게시글 수정
      </h1>
      <p style="color: var(--text-secondary); font-size: 1.1rem;">
        작성하신 게시글을 수정해주세요
      </p>
    </div>

    <!-- 메인 카드 -->
    <div class="card" style="max-width: 800px; margin: 0 auto; box-shadow: var(--shadow-lg);">
      <div class="card-header" style="text-align: center; background: linear-gradient(135deg, var(--primary-color), var(--primary-dark)); color: white; border-radius: 0.75rem 0.75rem 0 0;">
        <h2 style="margin: 0; font-size: 1.5rem;">
          📝 게시글 정보 수정
        </h2>
      </div>

      <div class="card-body" style="padding: 2.5rem;">
        <% if (error) { %>
          <div style="background-color: #fef2f2; border: 1px solid #fecaca; color: #dc2626; padding: 1rem; border-radius: 0.5rem; margin-bottom: 2rem;">
            <strong>⚠️ 오류:</strong> <%= error %>
          </div>
        <% } %>

        <form action="/community/<%= post.id %>/edit" method="POST">
          <!-- 제목 입력 -->
          <div class="form-group">
            <label for="title" class="form-label" style="font-size: 1.1rem; font-weight: 600; color: var(--text-primary); display: flex; align-items: center; gap: 0.5rem;">
              <span style="color: var(--primary-color);">📌</span>
              제목
            </label>
            <input
              type="text"
              id="title"
              name="title"
              class="form-control"
              value="<%= post.title %>"
              placeholder="게시글 제목을 입력하세요"
              required
              style="font-size: 1rem; padding: 1rem; border-radius: 0.5rem; border: 2px solid var(--border-color); transition: all 0.3s ease;"
            >
          </div>

          <!-- 내용 입력 -->
          <div class="form-group">
            <label for="content" class="form-label" style="font-size: 1.1rem; font-weight: 600; color: var(--text-primary); display: flex; align-items: center; gap: 0.5rem;">
              <span style="color: var(--primary-color);">📝</span>
              내용
            </label>
            <textarea
              id="content"
              name="content"
              class="form-control"
              rows="12"
              placeholder="게시글 내용을 입력하세요"
              required
              style="font-size: 1rem; padding: 1rem; border-radius: 0.5rem; border: 2px solid var(--border-color); transition: all 0.3s ease; resize: vertical; min-height: 300px; font-family: inherit; line-height: 1.6;"
            ><%= post.content %></textarea>
          </div>

          <!-- 버튼 그룹 -->
          <div style="display: flex; gap: 1rem; justify-content: center; margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--border-color);">
            <button
              type="submit"
              class="btn btn-primary"
              style="padding: 1rem 2rem; font-size: 1.1rem; font-weight: 600; border-radius: 0.5rem; display: flex; align-items: center; gap: 0.5rem; min-width: 140px; justify-content: center;"
            >
              <span>✅</span>
              수정하기
            </button>

            <a
              href="/community/<%= post.id %>"
              class="btn btn-outline"
              style="padding: 1rem 2rem; font-size: 1.1rem; font-weight: 600; border-radius: 0.5rem; display: flex; align-items: center; gap: 0.5rem; min-width: 140px; justify-content: center; text-decoration: none;"
            >
              <span>❌</span>
              취소
            </a>
          </div>
        </form>
      </div>
    </div>

    <!-- 추가 정보 -->
    <div style="text-align: center; margin-top: 2rem; color: var(--text-secondary);">
      <small>
        💡 수정된 내용은 즉시 반영됩니다. 신중하게 작성해주세요.
      </small>
    </div>

  </div>
</div>

<%- include('../layout/footer') %>

