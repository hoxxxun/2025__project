<%- include('../layout/header') %>

<div style="margin-bottom: 2rem;">
  <h2 style="font-size: 2rem; margin-bottom: 1rem;">💬 채팅</h2>
  <p style="color: var(--text-secondary);">다른 사용자들과 1:1 채팅을 시작하세요.</p>
</div>

<% if (locals.error) { %>
  <div class="alert alert-danger">
    <%= error %>
  </div>
<% } %>

<% if (locals.user) { %>
  <div class="card" style="max-width: 600px;">
    <div class="card-header">
      <h3>사용 가능한 사용자</h3>
    </div>
    
    <% if (users && users.length > 0) { %>
      <div style="padding: 1rem;">
        <% users.forEach(otherUser => { %>
          <%
            const age = otherUser.age;
            const genderIcon = otherUser.gender === '남' || otherUser.gender === 'M' || otherUser.gender === 'male' ? '👨' : '👩';
            const genderText = otherUser.gender === '남' || otherUser.gender === 'M' || otherUser.gender === 'male' ? '남성' : '여성';
            const genderColor = otherUser.gender === '남' || otherUser.gender === 'M' || otherUser.gender === 'male' ? '#2196F3' : '#E91E63';
          %>
          <div style="display: flex; justify-content: space-between; align-items: center; padding: 1rem; border-bottom: 1px solid var(--border-color); background: linear-gradient(135deg, <%= genderColor %>15, <%= genderColor %>08); border-left: 4px solid <%= genderColor %>;">
            <div>
              <div style="font-weight: 600; color: var(--text-primary);">
                <span style="font-size: 1.2rem;"><%= genderIcon %></span> <%= otherUser.username %>
                <span style="font-size: 0.8rem; color: <%= genderColor %>; font-weight: 600; background: <%= genderColor %>20; padding: 0.2rem 0.5rem; border-radius: 1rem;">
                  <% if (age !== null && age !== undefined) { %>
                    <%= age %>세 <%= genderText %>
                  <% } else { %>
                    <%= genderText %>
                  <% } %>
                </span>
              </div>
              <% if (otherUser.nickname) { %>
                <div style="font-size: 0.875rem; color: var(--text-secondary);">
                  <%= otherUser.nickname %>
                </div>
              <% } %>
            </div>
            <a href="/chat/room/<%= otherUser.id %>" class="btn btn-primary" style="white-space: nowrap;">
              채팅 시작
            </a>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div style="padding: 2rem; text-align: center; color: var(--text-secondary);">
        <div class="empty-state-icon">😢</div>
        <p>아직 채팅할 수 있는 사용자가 없습니다.</p>
      </div>
    <% } %>
  </div>

  <!-- 활성 채팅방 -->
  <% if (chatRooms && chatRooms.length > 0) { %>
    <div class="card" style="max-width: 600px; margin-top: 2rem;">
      <div class="card-header">
        <h3>진행 중인 채팅</h3>
      </div>
      
      <div style="padding: 1rem;">
        <% chatRooms.forEach(room => { %>
          <%
            const otherUserId = room.user1Id === user.id ? room.user2Id : room.user1Id;
            const otherUser = users?.find(u => u.id === otherUserId);
            const age = otherUser?.age;
            const genderIcon = otherUser?.gender === '남' || otherUser?.gender === 'M' || otherUser?.gender === 'male' ? '👨' : '👩';
            const genderText = otherUser?.gender === '남' || otherUser?.gender === 'M' || otherUser?.gender === 'male' ? '남성' : '여성';
            const genderColor = otherUser?.gender === '남' || otherUser?.gender === 'M' || otherUser?.gender === 'male' ? '#2196F3' : '#E91E63';
          %>
          <a href="/chat/room/<%= otherUserId %>" style="text-decoration: none;">
            <div style="display: flex; justify-content: space-between; align-items: center; padding: 1rem; border-bottom: 1px solid var(--border-color); background: linear-gradient(135deg, <%= genderColor %>10, <%= genderColor %>05); border-radius: 0.5rem; margin-bottom: 0.5rem; cursor: pointer; transition: all 0.3s ease; border-left: 4px solid <%= genderColor %>;" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 4px 12px rgba(0,0,0,0.1)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none';">
              <div>
                <div style="font-weight: 600;">
                  <span style="font-size: 1.2rem;"><%= genderIcon %></span> <%= otherUser?.username || '알 수 없음' %>
                  <% if (otherUser && age !== null && age !== undefined) { %>
                    <span style="font-size: 0.8rem; color: <%= genderColor %>; font-weight: 600; background: <%= genderColor %>20; padding: 0.2rem 0.5rem; border-radius: 1rem;">
                      <%= age %>세 <%= genderText %>
                    </span>
                  <% } else if (otherUser) { %>
                    <span style="font-size: 0.8rem; color: <%= genderColor %>; font-weight: 600; background: <%= genderColor %>20; padding: 0.2rem 0.5rem; border-radius: 1rem;">
                      <%= genderText %>
                    </span>
                  <% } %>
                </div>
                <div style="font-size: 0.875rem; margin-top: 0.25rem;">
                  마지막: <%= room.lastMessage?.substring(0, 30) || '메시지 없음' %>
                </div>
              </div>
              <div style="text-align: right;">
                <div style="font-size: 0.75rem;">
                  <%= room.lastMessageTime?.toLocaleDateString('ko-KR') %>
                </div>
              </div>
            </div>
          </a>
        <% }); %>
      </div>
    </div>
  <% } %>

<% } else { %>
  <div class="alert alert-info">
    채팅을 사용하려면 <a href="/auth/login">로그인</a>해주세요.
  </div>
<% } %>

<%- include('../layout/footer') %>
