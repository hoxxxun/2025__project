<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Fortune For You - 소셜 플랫폼</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <div class="navbar-container">
      <a href="/" class="navbar-brand">
        🌟 Fortune For You
      </a>
      
      <% if (locals.user) { %>
        <nav class="navbar-menu">
          <li><a href="/community">커뮤니티</a></li>
          <li><a href="/analysis">개인 성향 분석</a></li>
          <li><a href="/matching/compatibility">두 사람 궁합 분석</a></li>
          <li><a href="/chat/list">채팅</a></li>
        </nav>
        
        <div class="navbar-auth">
          <span style="color: white; padding: 0.5rem 1rem;"><%- user.username %></span>
          <a href="/auth/logout" class="login-btn">로그아웃</a>
        </div>
      <% } else { %>
        <div class="navbar-auth">
          <a href="/auth/login" class="login-btn">로그인</a>
          <a href="/auth/signup" class="signup-btn">회원가입</a>
        </div>
      <% } %>
    </div>
  </header>

  <main class="container">
