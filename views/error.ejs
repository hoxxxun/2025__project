<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>오류 - Fortune For You</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <div class="navbar-container">
      <a href="/" class="navbar-brand">
        🌟 Fortune For You
      </a>
      <div class="navbar-menu">
        <% if (locals.user) { %>
          <li><a href="/community">커뮤니티</a></li>
          <li><a href="/analysis">개인 성향 분석</a></li>
          <li><a href="/matching/compatibility">두 사람 궁합 분석</a></li>
          <li><a href="/chat/list">채팅</a></li>
        <% } %>
      </div>
      <% if (locals.user) { %>
        <div class="navbar-auth">
          <span>환영합니다, <%= locals.user.username %>님!</span>
          <a href="/auth/logout" class="logout-btn">로그아웃</a>
        </div>
      <% } else { %>
        <div class="navbar-auth">
          <a href="/auth/login" class="login-btn">로그인</a>
          <a href="/auth/signup" class="signup-btn">회원가입</a>
        </div>
      <% } %>
    </div>
  </header>

  <main class="container">
    <div class="error-container">
      <div class="error-card">
        <div class="error-icon">
          ❌
        </div>
        <h1>오류가 발생했습니다</h1>
        <p class="error-message">
          <% if (typeof error === 'string') { %>
            <%= error %>
          <% } else if (error && error.message) { %>
            <%= error.message %>
          <% } else { %>
            알 수 없는 오류가 발생했습니다.
          <% } %>
        </p>
        <div class="error-actions">
          <a href="/" class="btn btn-primary">홈으로 돌아가기</a>
          <button onclick="history.back()" class="btn btn-outline">이전 페이지로</button>
        </div>
      </div>
    </div>
  </main>

  <footer>
    <div class="footer-content">
      <div class="footer-section">
        <h3>📱 Fortune For You</h3>
        <p>로그인, 채팅, 커뮤니티를 한 곳에서!</p>
      </div>

      <div class="footer-section">
        <h3>👥 커뮤니티</h3>
        <a href="/community/list">게시글 보기</a>
        <a href="/community/write">글쓰기</a>
      </div>

      <div class="footer-section">
        <h3>💬 채팅</h3>
        <a href="/chat/list">채팅 시작</a>
      </div>

      <div class="footer-section">
        <h3>계정</h3>
        <% if (locals.user) { %>
          <a href="/auth/logout">로그아웃</a>
        <% } else { %>
          <a href="/auth/login">로그인</a>
          <a href="/auth/signup">회원가입</a>
        <% } %>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; 2025 Fortune For You. All rights reserved.</p>
    </div>
  </footer>

  <script src="/js/main.js"></script>
</body>
</html>
